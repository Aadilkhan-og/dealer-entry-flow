{
  "expo": {
    "name": "DealerFlow",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B4FFF"
    },
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "DealerFlow needs camera access to scan Aadhaar cards, IMEI barcodes, and capture phone photos.",
        "NSPhotoLibraryUsageDescription": "DealerFlow needs photo library access to save and attach phone images."
      }
    },
    "android": {
      "package": "com.dealerflow.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "DealerFlow needs camera access to scan Aadhaar cards, IMEI barcodes, and capture phone photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "DealerFlow needs photo access to attach phone images.",
          "cameraPermission": "DealerFlow needs camera access to capture phone photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "7a9b98e1-72fd-4a02-b685-dabd9fe2531e"
      }
    },
    "owner": "aadilkhan"
  }
}
